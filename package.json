{
  "name": "@yourco/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDK for the platform api: sign-in, typed client, React Query hooks.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:types": "openapi-typescript ../api/openapi.json -o src/generated-types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@types/react": "^18.3.29",
    "openapi-typescript": "^7.9.1",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
